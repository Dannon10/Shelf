{
  "expo": {
    "name": "Shelf",
    "slug": "shelf",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0F0F0F"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.shelf.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Shelf needs access to your photos to add product images.",
        "NSCameraUsageDescription": "Shelf needs camera access to photograph your products."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F0F0F"
      },
      "permissions": [
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "CAMERA"
      ],
      "package": "com.shelf.app"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Shelf needs access to your photos to add product images."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#FF6B35"
        }
      ]
    ]
  }
}